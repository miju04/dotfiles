# ~/.profile: executed by the command interpreter for login shells.
# This file is not read by bash(1), if ~/.bash_profile or ~/.bash_login
# exists.
# see /usr/share/doc/bash/examples/startup-files for examples.
# the files are located in the bash-doc package.

# the default umask is set in /etc/profile; for setting the umask
# for ssh logins, install and configure the libpam-umask package.
#umask 022

source_this() {
  if [[ -s "$1" ]]; then
    . "$1"
  fi
}

add_to_var() {
  if [[ -n "$2" ]]; then
    eval "local current=\${$1}"
    if [[ -z "$current" ]]; then
      export "$1=$2"
    else
      export "$1=$2:$current"
    fi
  fi
}

# if running bash
if [[ -n "$BASH_VERSION" ]]; then
  # include .bashrc if it exists
  source_this "$HOME/.bashrc"
fi

add_to_var "KUBECONFIG" "$HOME/.kube/config"
add_to_var "KUBECONFIG" "$HOME/.kube/t14.yaml"
add_to_var "KUBECONFIG" "$HOME/.kube/t21.yaml"
add_to_var "KUBECONFIG" "$HOME/.kube/p14.yaml"
add_to_var "KUBECONFIG" "$HOME/.kube/p21.yaml"
add_to_var "KUBECONFIG" "$HOME/.kube/p3241.yaml"
add_to_var "KUBECONFIG" "$HOME/.kube/kgateway-poc.yaml"
add_to_var "KUBECONFIG" "$HOME/.kube/envoy-poc.yaml"

export XDG_RUNTIME_DIR="/run/user/$UID"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

add_to_var "DBUS_SESSION_BUS_ADDRESS" "unix:path=${XDG_RUNTIME_DIR}/bus"

export MANPAGER='nvim +Man!'
export GCM_CREDENTIAL_STORE="gpg"

add_to_var "PATH" "$HOME/bin"
add_to_var "PATH" "$HOME/.local/bin"
add_to_var "PATH" "$HOME/go/bin"
add_to_var "PATH" "$HOME/.cargo/bin"

# Added by Toolbox App
add_to_var "PATH" "$HOME/.local/share/JetBrains/Toolbox/scripts"

export NVM_DIR="$HOME/.nvm"
source_this "$NVM_DIR/nvm.sh"
source_this "$NVM_DIR/bash_completion"

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
source_this "$SDKMAN_DIR/bin/sdkman-init.sh"

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
*":$PNPM_HOME:"*) ;;
*) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# Load Angular CLI autocompletion.
if command -v ng &>/dev/null; then
  source <(ng completion script)
fi
