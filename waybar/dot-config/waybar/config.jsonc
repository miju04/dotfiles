// -*- mode: jsonc -*-
{
  "layer": "top",
  "position": "top",
  "spacing": 2,
  "modules-left": [
    "custom/arch",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "idle_inhibitor",
    "pulseaudio",
    "backlight",
    "network",
    "memory",
    "cpu",
    "temperature",
    "battery"
  ],
  "include": [
    "~/.config/waybar/modules.json"
  ]
}
