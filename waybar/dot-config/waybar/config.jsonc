// -*- mode: jsonc -*-
{
  "layer": "top",
  "position": "top",
  "spacing": 2,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/arch",
    "hyprland/submap",
    "systemd-failed-units",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "idle_inhibitor",
    "wireplumber",
    "bluetooth",
    "network",
    "group/hardware"
  ],
  "include": [
    "~/.config/waybar/modules.json"
  ]
}
