{
  "custom/arch": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "btw",
    "on-click": "rofi -show drun -run-command \"uwsm app -- {cmd}\""
  },
  "systemd-failed-units": {
    "format": "󰅚 {nr_failed}",
    "system": true,
    "user": true,
    "hide-on-ok": true,
    "tooltip-format": "{nr_failed} failed units:\n{failed_units_list}",
    "tooltip-unit-format": "{scope}: {name} ({active_state})"
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 48,
    "fallback": "Desktop",
    "tooltip-format": "{class}"
  },
  "hyprland/submap": {
    "format": "{icon} {submap}",
    "max-length": 12,
    "tooltip": false,
    "icons": {
      "resize": "󰆾"
    }
  },
  "group/hardware": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 400,
      "children-class": "hardware-child",
      "transition-left-to-right": false,
      "click-to-reveal": true
    },
    "modules": [
      "battery",
      "cpu",
      "memory",
      "temperature",
      "backlight"
    ]
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{name}"
  },
  "bluetooth": {
    "format": "󰂲",
    "format-icons": [
      "󰤾",
      "󰤿",
      "󰥀",
      "󰥁",
      "󰥂",
      "󰥃",
      "󰥄",
      "󰥅",
      "󰥆",
      "󰥈"
    ],
    "format-on": "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "{device_alias} {icon}",
    "tooltip-format": "{controller_alias}\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}  {device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} {device_battery_percentage}%  {device_address}",
    "on-click": "ghostty --command=bluetui"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "wireplumber": {
    "format": "{icon} {volume}% {format_source}",
    "format-bluetooth": "{icon} {volume}% 󰂯 {format_source}",
    "format-bluetooth-muted": "󰖁 {icon} 󰂯 {format_source}",
    "format-muted": "󰖁 {format_source}",
    "format-source": "",
    "format-source-muted": "󰍭",
    "format-icons": {
      "headphone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "network": {
    "interval": 5,
    "format-alt": "{icon} {bandwidthUpBytes:>}  {bandwidthDownBytes:>} ",
    "format-wifi": "{icon} {essid:5.15}",
    "format-ethernet": "󰈀 {bandwidthUpBytes:>}  {bandwidthDownBytes:>} ",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)  {frequency}GHz\ndevice:\t{ifname}\nip:\t\t{ipaddr}/{cidr}\nvia:\t\t{gwaddr}\nup:\t\t{bandwidthUpBytes}\ndown:\t\t{bandwidthDownBytes}",
    "tooltip-format": "{essid} \ndevice:\t{ifname}\nip:\t\t{ipaddr}/{cidr}\nvia:\t\t{gwaddr}\nup:\t\t{bandwidthUpBytes}\ndown:\t\t{bandwidthDownBytes}",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "󰤮",
    "format-icons": [
      "󰤫",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "on-click-right": "ghostty --command=impala"
  },
  "cpu": {
    "format": " {usage}%",
    "tooltip": true,
    "on-click": "ghostty --command=btop"
  },
  "memory": {
    "format": " {}%",
    "tooltip": true,
    "tooltip-format": "RAM:   {used:0.1f} / {total:0.1f} GiB\nSWAP: {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
    "on-click": "ghostty --command=btop"
  },
  "temperature": {
    "interval": 10,
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 95,
    "format-critical": " {temperatureC}°C",
    "format": " {temperatureC}°C",
    "on-click": "ghostty --command=btop"
  },
  "backlight": {
    "format": "{icon}",
    "tooltip-format": "{percent}%",
    "format-icons": [
      "󱩎",
      "󱩏",
      "󱩐",
      "󱩑",
      "󱩒",
      "󱩓",
      "󱩔",
      "󱩕",
      "󱩖",
      "󰛨"
    ]
  },
  "battery": {
    "interval": 5,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "-{power}W {icon}",
    "format-alt-click": "click-right",
    "format-icons": {
      "default": [
        "󰂎",
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
      "charging": [
        "󰢟",
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ]
    },
    "tooltip-format": "Battery information\nCapacity:\t{capacity}%\nPower:\t\t{power}W\nTime:\t\t{time}\nCycles:\t\t{cycles}\nHealth:\t\t{health}%",
    "events": {
      "on-discharging-warning": "notify-send -u normal -i battery-caution 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical -i battery-caution 'Very Low Battery'"
    }
  },
  "clock": {
    "interval": 1,
    "format": "{:%H:%M | %e %b}",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "iso8601": true,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#bb9af7'><b>{}</b></span>",
        "days": "<span color='#c0caf5'>{}</span>",
        "weeks": "<span color='#ff9e64'>{}</span>",
        "weekdays": "<span color='#7dcfff'><b>{}</b></span>",
        "today": "<span color='#f7768e'><b><u>{}</u></b></span>"
      }
    },
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%H:%M:%S}",
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  }
}
