{
  "custom/arch": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "btw",
    "on-click": "rofi -show drun -run-command \"uwsm app -- {cmd}\""
  },
  "systemd-failed-units": {
    "format": "󰅚 {nr_failed}",
    "system": true,
    "user": true,
    "hide-on-ok": true,
    "tooltip-format": "{nr_failed} failed units:\n{failed_units_list}",
    "tooltip-unit-format": "{scope}: {name} ({active_state})"
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 48,
    "fallback": "Desktop",
    "tooltip-format": "{class}"
  },
  "hyprland/submap": {
    "format": "{icon} {submap}",
    "max-length": 12,
    "tooltip": false,
    "icons": {
      "resize": "󰆾"
    }
  },
  "group/hardware": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 400,
      "children-class": "hardware-child",
      "transition-left-to-right": false
    },
    "modules": [
      "cpu",
      "memory",
      "temperature",
      "backlight"
    ]
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{name}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "wireplumber": {
    "format": "{icon} {volume}% {format_source}",
    "format-bluetooth": "{icon} {volume}%  {format_source}",
    "format-bluetooth-muted": "󰖁 {icon} {format_source}",
    "format-muted": "󰖁 {format_source}",
    "format-source": "",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "network": {
    "interval": 5,
    "format-alt": "  {bandwidthUpBytes:>}  {bandwidthDownBytes:>}",
    "format-wifi": "  {essid:5.15} ({signalStrength}%)",
    "format-ethernet": "  {bandwidthUpBytes:>}  {bandwidthDownBytes:>}",
    "tooltip-format": "{essid} ({signalStrength}%)  {frequency}GHz\ndevice:\t{ifname}\nip:\t\t{ipaddr}/{cidr}\nvia:\t\t{gwaddr}\nup:\t\t{bandwidthUpBytes}\ndown:\t{bandwidthDownBytes}",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected ⚠",
    "on-click-right": "ghostty --command=impala"
  },
  "cpu": {
    "format": " {usage}%",
    "tooltip": true,
    "on-click": "ghostty --command=btop"
  },
  "memory": {
    "format": " {}%",
    "tooltip": true,
    "tooltip-format": "RAM:   {used:0.1f} / {total:0.1f} GiB\nSWAP: {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
    "on-click": "ghostty --command=btop"
  },
  "temperature": {
    "interval": 10,
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 100,
    "format-critical": " {temperatureC}",
    "format": " {temperatureC}°C",
    "on-click": "ghostty --command=btop"
  },
  "backlight": {
    "format": " {percent}%",
    "format-icons": [
      "",
      ""
    ]
  },
  "battery": {
    "interval": 5,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon} -{power}W",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "events": {
      "on-discharging-warning": "notify-send -u normal -i battery-caution 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical -i battery-caution 'Very Low Battery'"
    }
  },
  "clock": {
    "interval": 1,
    "format": "{:%H:%M | %e %b}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%H:%M:%S}"
  }
}
