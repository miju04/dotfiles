* {
    bg: rgba(22, 22, 30, 0.70);
    bg-solid: rgba(22, 22, 30, 0.90);
    bg-highlight: #292e42;
    selection: #283457;
    border-color: #3b4261;

    font: "MesloLGS Nerd Font 11";

    fg: #c0caf5;
    fg-dark: #a9b1d6;
    comment: #565f89;

    blue: #7aa2f7;
    cyan: #7dcfff;
    magenta: #bb9af7;
    green: #9ece6a;
    red: #f7768e;
    orange: #ff9e64;
    orange-bold: bold #ff9e64;

    selected-fg: #15161e;

    background-color: transparent;
    border: 0px;
    text-color: @fg;
}

window {
    width: 500;
    orientation: horizontal;
    location: center;
    anchor: center;
    background-color: @bg;
    border: 1px;
    border-color: @border-color;
    border-radius: 10px;
    spacing: 0;
    children: [ mainbox ];
}

mainbox {
    spacing: 0;
    background-color: transparent;
    children: [ inputbar, message, listview ];
}

inputbar {
    color: @fg;
    background-color: transparent;
    padding: 12px;
    border: 0px 0px 1px 0px;
    border-color: @border-color;
    border-radius: 10px 10px 0px 0px;
}

message {
    padding: 8px 12px;
    background-color: transparent;
    border: 0px 0px 1px 0px;
    border-color: @border-color;
}

textbox {
    background-color: transparent;
    text-color: @fg-dark;
}

entry, prompt, case-indicator {
    text-font: inherit;
    text-color: inherit;
    background-color: transparent;
}

prompt {
    margin: 0px 8px 0px 0px;
    text-color: @cyan;
}

entry {
    text-color: @fg;
    placeholder: "Search...";
    placeholder-color: @comment;
}

case-indicator {
    text-color: @comment;
}

listview {
    layout: vertical;
    padding: 8px;
    lines: 7;
    columns: 1;
    background-color: transparent;
    border: 0px;
    border-radius: 0px 0px 10px 10px;
    dynamic: false;
    scrollbar: false;
}

element {
    padding: 6px 8px;
    vertical-align: 0.5;
    color: @fg-dark;
    background-color: transparent;
    border-radius: 6px;
}

element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @selection;
    text-color: @fg;
}

element selected.urgent, element selected.active {
    background-color: @selection;
    text-color: @fg;
}

element-text {
    background-color: inherit;
    color: inherit;
    vertical-align: 0.5;
    highlight: @orange-bold;
}

element-icon {
    background-color: inherit;
    size: 1.5em;
}
